{
  "name": "Tekrowe",
  "version": "1.0.0",
  "description": "Tekrowe project",
  "author": {
    "name": "Muhammad Saleem",
    "email": "muhammad.saleem@tekrowe.com"
  },
  "private": false,
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "TZ='UTC' NODE_OPTIONS='--max-old-space-size=4096' nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "ts-node --transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js --config src/config/database.ts",
    "schema:sync": "npm run typeorm schema:sync",
    "add:migration": "npm run build && npm run typeorm migration:generate -- -n",
    "apply:migration": "npm run build && npm run typeorm migration:run",
    "revert:migration": "npm run build && npm run typeorm migration:revert",
    "drop:database": "npm run typeorm schema:drop",
    "heroku-postbuild": "npm install --legacy-peer-deps && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.370.0",
    "@aws-sdk/client-s3": "^3.620.1",
    "@aws-sdk/s3-request-presigner": "^3.620.1",
    "@casl/ability": "^5.4.3",
    "@mapbox/polyline": "^1.2.1",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/common": "^8.4.7",
    "@nestjs/config": "^2.3.1",
    "@nestjs/core": "^8.4.7",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/passport": "^8.0.1",
    "@nestjs/platform-express": "^8.1.1",
    "@nestjs/schedule": "^1.0.1",
    "@nestjs/swagger": "^5.2.1",
    "@nestjs/typeorm": "^8.0.2",
    "@turf/centroid": "^7.0.0",
    "@turf/helpers": "^7.0.0",
    "amazon-cognito-identity-js": "^6.3.1",
    "aws-amplify": "^5.3.3",
    "aws-sdk": "^2.1418.0",
    "axios": "^1.7.2",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^10.0.0",
    "express": "^4.18.2",
    "firebase-admin": "^12.1.1",
    "geojson": "^0.5.0",
    "geolib": "^3.3.4",
    "googleapis": "^137.1.0",
    "helmet": "^4.6.0",
    "mysql": "^2.18.1",
    "nestjs-pino": "^3.1.2",
    "nestjs-typeorm-paginate": "^4.0.4",
    "nodemailer": "^6.9.13",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.7.1",
    "pino-http": "^8.3.3",
    "pino-pretty": "^9.3.0",
    "pusher": "^5.2.0",
    "redis": "^3.1.1",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.2.0",
    "stripe": "^15.12.0",
    "swagger-ui-express": "^4.6.2",
    "twilio": "^5.2.2",
    "typeorm": "^0.3.12",
    "webpack": "^5.76.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.0.1",
    "@commitlint/config-conventional": "^17.0.0",
    "@nestjs/cli": "^8.0.0",
    "@nestjs/schematics": "^8.0.0",
    "@nestjs/testing": "^8.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.2",
    "@types/cron": "^1.7.3",
    "@types/eslint": "^7.28.0",
    "@types/eslint-config-prettier": "^6.11.0",
    "@types/eslint-plugin-prettier": "^3.1.0",
    "@types/express": "^4.17.13",
    "@types/geojson": "^7946.0.14",
    "@types/jest": "^27.4.0",
    "@types/node": "^16.0.0",
    "@types/nodemailer": "^6.4.15",
    "@types/passport": "^1.0.7",
    "@types/passport-jwt": "^3.0.6",
    "@types/passport-local": "^1.0.34",
    "@types/pg": "^8.6.1",
    "@types/prettier": "^2.3.2",
    "@types/rimraf": "^3.0.2",
    "@types/supertest": "^2.0.11",
    "@types/swagger-ui-express": "^4.1.3",
    "@typescript-eslint/eslint-plugin": "^4.28.2",
    "@typescript-eslint/parser": "^4.28.2",
    "eslint": "^7.30.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^3.4.0",
    "jest": "27.0.6",
    "prettier": "^2.3.2",
    "supertest": "^6.1.3",
    "ts-jest": "^27.0.3",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^3.10.1",
    "typescript": "^4.3.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
